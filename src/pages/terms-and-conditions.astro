---
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Footer from '../components/Footer.astro';

const title = 'Terms & Conditions — SEE GPA Calculator | Seepapers.com';
const description =
  'Terms and Conditions for using the SEE GPA Calculator on tools.seepapers.com. Read about acceptable use, accuracy, disclaimers and intellectual property.';

const email = 'contact@seepapers.com';
const updated = 'June 24, 2026';
---

<Layout title={title} description={description} canonical="/terms-and-conditions">
  <Header />

  <main class="mx-auto max-w-3xl px-4 py-14 sm:px-6">
    <nav aria-label="Breadcrumb" class="mb-6 text-sm text-mute">
      <a href="/" class="hover:text-ink">Home</a> <span aria-hidden="true">›</span> Terms &amp; Conditions
    </nav>

    <h1 class="text-3xl font-bold tracking-tight text-ink sm:text-4xl">Terms &amp; Conditions</h1>
    <p class="mt-3 text-sm text-mute">Last updated: {updated}</p>

    <div class="mt-8 space-y-5 text-base leading-relaxed text-body">
      <p>
        Welcome to <strong class="text-ink">tools.seepapers.com</strong>. By using the SEE GPA Calculator and related
        tools, you agree to these Terms &amp; Conditions. If you do not agree, please do not use the site.
      </p>

      <h2 class="text-xl font-semibold text-ink">1. Use of the tool</h2>
      <p>
        The SEE GPA Calculator, planner, +2 eligibility checker and marksheet generator are provided free of charge for
        personal, educational use. You may use them to estimate your GPA and plan your studies. You agree not to misuse
        the site, attempt to disrupt it, or use it for any unlawful purpose.
      </p>

      <h2 class="text-xl font-semibold text-ink">2. Accuracy and disclaimer</h2>
      <p>
        We work hard to follow the official National Examinations Board (NEB) grading system. However, results from
        this tool are <strong class="text-ink">estimates</strong> for study planning only and are not official. We do
        not guarantee that every result is error-free. Your official GPA, marksheet and +2 eligibility are determined
        solely by the NEB. Always confirm with your official NEB SEE marksheet.
      </p>

      <h2 class="text-xl font-semibold text-ink">3. No professional advice</h2>
      <p>
        Information on this site, including +2 stream eligibility guidance, is general in nature. It is not a
        substitute for official guidance from your school, the NEB, or the colleges you apply to.
      </p>

      <h2 class="text-xl font-semibold text-ink">4. Intellectual property</h2>
      <p>
        The design, text and code of this site are owned by Seepapers.com unless stated otherwise. You may not copy or
        redistribute substantial parts of the site without permission. "SEE" and "NEB" refer to the respective
        official bodies in Nepal and are used here for descriptive purposes only.
      </p>

      <h2 class="text-xl font-semibold text-ink">5. Limitation of liability</h2>
      <p>
        The site is provided "as is" without warranties of any kind. To the fullest extent permitted by law,
        Seepapers.com is not liable for any loss or damage arising from your use of, or reliance on, this tool or its
        results.
      </p>

      <h2 class="text-xl font-semibold text-ink">6. Third-party links and ads</h2>
      <p>
        We may link to external sites and display advertising. We are not responsible for the content, products or
        practices of third parties. See our <a href="/privacy-policy" class="see-link">Privacy Policy</a> for how
        analytics and ads work.
      </p>

      <h2 class="text-xl font-semibold text-ink">7. Changes</h2>
      <p>
        We may update these Terms from time to time. The "Last updated" date shows the latest revision. Continued use
        of the site means you accept the updated Terms.
      </p>

      <h2 class="text-xl font-semibold text-ink">8. Contact</h2>
      <p>
        Questions about these Terms? Email
        <a href={`mailto:${email}`} class="see-link">{email}</a> or visit our
        <a href="/contact-us" class="see-link">Contact page</a>.
      </p>
    </div>
  </main>

  <Footer />
</Layout>

<style>
  .see-link {
    color: #7928ca;
    font-weight: 600;
    text-decoration: underline;
    text-underline-offset: 2px;
  }
  .see-link:hover { color: #007cf0; }
  :global(.dark) .see-link { color: #b388ff; }
</style>
