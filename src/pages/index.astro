---
/**
 * index.astro — Main page: composes all static sections and mounts exactly
 * one <CalculatorIsland client:load />.
 *
 * Architecture (Requirements 1.1–1.4, 21.1, 21.2):
 *   - All layout sections are logic-free .astro components (no calc state)
 *   - A single React island carries all interactive calculator logic
 *   - `client:load` hydrates the island immediately on page load
 */
import Layout from '../layouts/Layout.astro';
import Header from '../components/Header.astro';
import Hero from '../components/Hero.astro';
import GradingScaleReference from '../components/GradingScaleReference.astro';
import MethodologyNote from '../components/MethodologyNote.astro';
import SeoContentSlots from '../components/SeoContentSlots.astro';
import Footer from '../components/Footer.astro';
import CalculatorIsland from '../components/calculator/CalculatorIsland';

// Page-level structured data: describes the tool itself as a free web
// application (helps Google rich results + AI engines understand the entity).
const appSchema = {
  '@context': 'https://schema.org',
  '@type': 'WebApplication',
  name: 'SEE GPA Calculator',
  alternateName: ['Seepapers SEE GPA Calculator', 'NEB SEE GPA Calculator', 'SEE GPA Planner'],
  url: 'https://tools.seepapers.com/',
  applicationCategory: 'EducationalApplication',
  operatingSystem: 'Web',
  inLanguage: 'en-NP',
  description:
    'Free SEE GPA calculator for Nepali Class 10 students. Calculate NEB Grade Point Average from grades or marks, plan a target GPA, check +2 stream eligibility for Science, Management and Humanities, and generate a SEE marksheet.',
  featureList: [
    'GPA calculator (grades or raw marks)',
    'Target GPA planner',
    '+2 stream eligibility checker',
    'SEE marksheet / transcript generator',
  ],
  isAccessibleForFree: true,
  offers: { '@type': 'Offer', price: '0', priceCurrency: 'NPR' },
  publisher: { '@type': 'Organization', name: 'Seepapers.com', url: 'https://seepapers.com/' },
};

const breadcrumbSchema = {
  '@context': 'https://schema.org',
  '@type': 'BreadcrumbList',
  itemListElement: [
    { '@type': 'ListItem', position: 1, name: 'Seepapers', item: 'https://seepapers.com/' },
    { '@type': 'ListItem', position: 2, name: 'SEE GPA Calculator', item: 'https://tools.seepapers.com/' },
  ],
};
---

<Layout>
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(appSchema)} />
  <script type="application/ld+json" slot="head" set:html={JSON.stringify(breadcrumbSchema)} />
  <!-- Static site header -->
  <Header />

  <!-- Hero intro -->
  <Hero />

  <!-- Calculator section — single hydrated island (Requirement 1.2, 1.4) -->
  <section id="calculator" class="bg-canvas border-b border-hairline">
    <div class="mx-auto max-w-5xl px-4 py-10 sm:px-6">
      <CalculatorIsland client:load />
    </div>
  </section>

  <!-- Static grading scale reference (Requirement 18.1, 18.2) -->
  <GradingScaleReference />

  <!-- Methodology explanation (Requirement 23.3) -->
  <MethodologyNote />

  <!-- SEO content placeholder slots (Requirement 22.2) -->
  <SeoContentSlots />

  <!-- Footer -->
  <Footer />
</Layout>
