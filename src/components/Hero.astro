---
// Hero.astro — premium, SaaS-style static intro section for the SEE GPA Calculator.
// No client JS and no calculator logic (Requirement 1.3, 21.2).
// All SEO microdata, the H1, description and feature list are preserved.
import hifive from '../assets/hifive.svg';
import hifiveDark from '../assets/hifive-dark.svg';

---

<section
  class="hero relative isolate border-b border-hairline bg-canvas"
  itemscope
  itemtype="https://schema.org/WebApplication"
>
  <!-- SEO: Microdata tells Google exactly what this tool does -->
  <meta itemprop="applicationCategory" content="EducationalApplication, CalculatorApplication" />
  <meta itemprop="name" content="SEE GPA Calculator — Seepapers.com" />
  <meta itemprop="operatingSystem" content="Web" />
  <meta itemprop="url" content="https://tools.seepapers.com/" />

  <!-- ── Atmospheric backdrop: soft mesh gradient + dotted grid ── -->
  <div class="hero-mesh" aria-hidden="true"></div>
  <div class="hero-grid" aria-hidden="true"></div>

  <!-- ── Floating academic geometry (decorative, hidden from AT) ── -->
  <div class="hero-floaters" aria-hidden="true">
    <!-- GPA badge — circle -->
    <div class="floater floater--a">
      <span class="chip chip--circle chip--violet">
        <span class="chip-text">GPA</span>
      </span>
    </div>

    <!-- A+ grade — rounded square -->
    <div class="floater floater--b">
      <span class="chip chip--square chip--blue">
        <span class="chip-text">A</span>
      </span>
    </div>

    <!-- Percent — circle -->
    <div class="floater floater--c">
      <span class="chip chip--circle chip--pink">
        <span class="chip-text">%</span>
      </span>
    </div>

    <!-- Bare geometric accents -->
  </div>

  <!-- ── Foreground content: desktop 2-col layout, mobile stacked ── -->
  <div class="relative z-10 mx-auto max-w-6xl px-4 py-16 sm:px-6 sm:pt-20 pb-8">
    <div class="flex flex-col-reverse items-center gap-8 lg:flex-row lg:items-center lg:gap-12">
      <!-- Left: Text content (centered on mobile, left-aligned on desktop) -->
      <div class="flex-1 text-center lg:text-left">
        <!-- SEO: Front-loaded primary keywords in the H1 -->
        <h1
          class="max-w-2xl text-balance text-3xl font-bold leading-[1.05] tracking-tight text-ink sm:text-5xl"
          itemprop="headline"
        >
          SEE <span class="">GPA Calculator</span><br> &amp; Planner
        </h1>

        <!-- SEO: Natural semantic text with secondary long-tail keywords -->
        <p class="mt-6 hidden sm:block max-w-2xl text-pretty text-base leading-relaxed text-body sm:text-lg" itemprop="description">
          A fast, free <strong class="font-semibold text-ink">SEE GPA calculator</strong> for Nepali Class 10 students. Calculate your GPA from marks or grades, plan target grades, check <strong class="font-semibold text-ink">+2 stream eligibility</strong>, and generate your <strong class="font-semibold text-ink">SEE marksheet</strong> using the official latest grading system.
        </p>

        <!-- SEO: semantic feature list -->
        <ul
          class="mt-10 flex flex-wrap justify-center gap-2.5 text-sm m-0 list-none p-0 lg:justify-start"
          aria-label="Calculator Features"
          itemprop="featureList"
        >
          <li class="rounded-pill border border-hairline bg-canvas-soft px-3.5 py-1.5 text-body backdrop-blur-sm">
            Grade &amp; Mark Conversion
          </li>
          <li class="rounded-pill border border-hairline bg-canvas-soft px-3.5 py-1.5 text-body backdrop-blur-sm">
            Target GPA Planner
          </li>
          <li class="rounded-pill border border-hairline bg-canvas-soft px-3.5 py-1.5 text-body backdrop-blur-sm">
            +2 Stream Eligibility Checks
          </li>
          <li class="rounded-pill border border-hairline bg-canvas-soft px-3.5 py-1.5 text-body backdrop-blur-sm">
            SEE Marksheet Generator
          </li>
        </ul>
      </div>

      <!-- Right: Hifive image (mobile: top-right, desktop: right side) -->
      <div class="flex-shrink-0 flex lg:flex items-center justify-center">
        <img src={hifive.src} alt="" class="dark:hidden h-32 sm:h-40 lg:h-48 w-auto" loading="lazy">
        <img src={hifiveDark.src} alt="" class="hidden dark:block h-32 sm:h-40 lg:h-48 w-auto" loading="lazy">
      </div>
    </div>
  </div>
</section>

<style>
  .hero {
    --g-violet: #7928ca;
    --g-blue: #007cf0;
    --g-cyan: #00dfd8;
    --g-pink: #ff0080;
    --g-amber: #f5a623;
  }

  

  :global(.dark) .hero-mesh {
    opacity: 0.5;
  }

  /* ── Dotted grid overlay ── */
  .hero-grid {
    position: absolute;
    inset: 0;
    z-index: 0;
    pointer-events: none;
    background-image: radial-gradient(currentColor 1px, transparent 1px);
    background-size: 26px 26px;
    color: var(--color-ink);
    opacity: 0.05;
    mask-image: radial-gradient(75% 70% at 50% 45%, #000 0%, transparent 100%);
    -webkit-mask-image: radial-gradient(75% 70% at 50% 45%, #000 0%, transparent 100%);
  }

  /* ── Floating chips ── */
  .hero-floaters {
    position: absolute;
    inset: 0;
    z-index: 1;
    pointer-events: none;
  }

  .floater {
    position: absolute;
    will-change: transform;
    animation: float var(--dur, 9s) ease-in-out infinite;
    animation-delay: var(--delay, 0s);
  }

  .chip {
    display: flex;
    align-items: center;
    justify-content: center;
    box-shadow:
      0 1px 1px rgba(0, 0, 0, 0.04),
      0 12px 28px -10px rgba(0, 0, 0, 0.18);
    backdrop-filter: blur(6px);
    -webkit-backdrop-filter: blur(6px);
  }

  .chip--circle {
    width: 3.5rem;
    height: 3.5rem;
    border-radius: 9999px;
  }

  .chip--square {
    width: 3.25rem;
    height: 3.25rem;
    border-radius: 14px;
  }

  .chip svg {
    width: 1.5rem;
    height: 1.5rem;
  }

  .chip-text {
    font-weight: 600;
    font-size: 0.95rem;
    letter-spacing: -0.02em;
  }

  .chip-text--serif {
    font-family: var(--font-mono);
    font-size: 1.35rem;
    line-height: 1;
  }

  /* Accent colors per chip */
  .chip--violet { color: var(--g-violet); }
  .chip--blue { color: var(--g-blue); }
  .chip--cyan { color: var(--g-cyan); }
  .chip--amber { color: var(--g-amber); }
  .chip--pink { color: var(--g-pink); }

  :global(.dark) .chip--cyan { color: #2ad6c6; }
  :global(.dark) .chip--blue { color: #3b9eff; }

  /* Positions + motion variety (desktop) */
  .floater--a { top: 18%; right: 8%;  --dur: 9s;  --delay: 0s; }
  .floater--b { top: 30%; right: 18%; --dur: 11s; --delay: 1.2s; }
  .floater--c { top: 62%; right: 11%; --dur: 10s; --delay: 0.6s; }
  .shape { position: absolute; will-change: transform; }
  .shape--ring {
    top: 22%; right: 26%;
    width: 1.5rem; height: 1.5rem;
    border-radius: 9999px;
    border: 2px solid color-mix(in srgb, var(--g-blue) 45%, transparent);
    animation: float 14s ease-in-out infinite;
  }
  .shape--dot {
    top: 50%; left: 30%;
    width: 0.6rem; height: 0.6rem;
    border-radius: 9999px;
    background: color-mix(in srgb, var(--g-pink) 60%, transparent);
    animation: float 8s ease-in-out infinite 0.8s;
  }
  .shape--tri {
    bottom: 16%; right: 30%;
    width: 0; height: 0;
    border-left: 0.6rem solid transparent;
    border-right: 0.6rem solid transparent;
    border-bottom: 1rem solid color-mix(in srgb, var(--g-amber) 55%, transparent);
    animation: float 12s ease-in-out infinite 1s;
  }

  @keyframes float {
    0%, 100% { transform: translateY(0) rotate(0deg); }
    50% { transform: translateY(-8px) rotate(3deg); }
  }

  /* ── Gradient headline text ── */
  .hero-gradient-text {
    background: linear-gradient(100deg, var(--g-violet), var(--g-blue) 55%, var(--g-cyan));
    -webkit-background-clip: text;
    background-clip: text;
    color: transparent;
  }

  /* Hide the smaller floaters on narrow screens to avoid clutter */
  @media (max-width: 640px) {
    .floater--b {
      display: block;
    }
    .floater--f,
    .floater--g,
    .shape--ring,
    .shape--tri {
      display: none;
    }
    /* Mobile: position floaters around hifive icon (center-right) */
    .floater--a { top: 8%; right: 32%; }
    .floater--b { top: 18%; left: 25%; }
    .floater--c { top: 32%; right: 44%; }
    .floater--d { top: 8%; right: 4%; }
    .floater--e { top: 78%; right: 4%; }
    .chip--circle { width: 2.75rem; height: 2.75rem; }
    .chip--square { width: 2.6rem; height: 2.6rem; }
    .chip svg { width: 1.15rem; height: 1.15rem; }
  }

  /* Respect reduced-motion preferences */
  @media (prefers-reduced-motion: reduce) {
    .floater,
    .shape {
      animation: none !important;
    }
  }
</style>
