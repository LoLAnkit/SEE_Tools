---
// GradingScaleReference.astro — pure static SEE grading-scale reference table.
// No client JS and no calculator logic (Requirement 1.3, 21.2).
//
// Every value (grade, grade point, percentage range, description) is sourced
// from GRADING_SCALE at build time so the static reference and the interactive
// calculator can never disagree (Requirement 18.1, 18.2). No grading literals
// are hardcoded in this file.

import { GRADING_SCALE } from "../config/gradingScale";

// Pre-format each band into display strings in the frontmatter so the template
// holds only config-derived values. GRADING_SCALE is ordered high -> low, so
// the first band (index 0) is the top band whose upper bound is inclusive of
// 100; every other band is inclusive-lower / exclusive-upper.
const rows = GRADING_SCALE.map((band, index) => ({
  grade: band.grade,
  gradePoint: band.gradePoint.toFixed(2),
  percentRange:
    index === 0
      ? `${band.minPercent} – ${band.maxPercent}`
      : `${band.minPercent} – <${band.maxPercent}`,
  description: band.description,
}));
---

<section id="grading-scale" class="border-b border-hairline bg-canvas">
  <div class="mx-auto max-w-5xl px-4 py-12 sm:px-6">
    <h2 class="text-2xl font-semibold tracking-tight text-ink">
      SEE grading scale
    </h2>
    <p class="mt-2 max-w-2xl text-sm text-mute">
      The official SEE 4.0 scale. Each band maps a percentage range to a letter
      grade and its grade point. Percentages use an inclusive lower bound; the
      top band is inclusive of 100.
    </p>

    <div class="mt-8 overflow-x-auto rounded-md border border-hairline">
      <table class="w-full border-collapse text-left text-sm">
        <caption class="sr-only">SEE 4.0 grading scale reference</caption>
        <thead>
          <tr class="border-b border-hairline bg-canvas-soft">
            <th scope="col" class="px-4 py-3 font-semibold text-ink">Grade</th>
            <th scope="col" class="px-4 py-3 font-semibold text-ink">Grade point</th>
            <th scope="col" class="px-4 py-3 font-semibold text-ink">Percentage range</th>
            <th scope="col" class="px-4 py-3 font-semibold text-ink">Description</th>
          </tr>
        </thead>
        <tbody>
          {
            rows.map((row) => (
              <tr class="border-b border-hairline last:border-b-0">
                <th scope="row" class="px-4 py-3 font-mono font-semibold text-ink">
                  {row.grade}
                </th>
                <td class="px-4 py-3 font-mono text-body">{row.gradePoint}</td>
                <td class="px-4 py-3 font-mono text-body">{row.percentRange}</td>
                <td class="px-4 py-3 text-body">{row.description}</td>
              </tr>
            ))
          }
        </tbody>
      </table>
    </div>
  </div>
</section>
